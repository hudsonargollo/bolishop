# ZARIERA — environment variables for Netlify
# Netlify → Site configuration → Environment variables → "Import from a .env file"
# Paste this list (with YOUR values). Never commit the filled-in copy.
# Full guide: docs/DEPLOY-NETLIFY.md

# ---- Required ----
# Cloud PostgreSQL (Neon / Netlify DB).
# DATABASE_URL = the POOLED string (host contains "-pooler") + &pgbouncer=true&connection_limit=1
# DIRECT_URL   = the same string WITHOUT "-pooler" (used only for migrations)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Your Netlify URL (or custom domain later), no trailing slash
NEXT_PUBLIC_SITE_URL="https://YOUR-SITE.netlify.app"

# Long random secret — generate a NEW one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="paste-a-new-48-byte-random-secret-here"

# ---- Store contact / socials (already chosen by the client) ----
NEXT_PUBLIC_CONTACT_EMAIL="jewelryzariera@gmail.com"
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/zariera_realm"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/share/1BNJEB67dh/"
NEXT_PUBLIC_TIKTOK_URL="https://www.tiktok.com/@zariera_realm"
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_CONTACT_PHONE=""
NEXT_PUBLIC_CONTACT_CITY="Lahore, Pakistan"
NEXT_PUBLIC_CONTACT_HOURS="Mon–Sat, 11am – 8pm"

# ---- Demo mode ----
# Lets "Book shipment" in the admin create a demo tracking number until the
# real Leopards / TCS keys are added. Remove (or set to "") when going live.
COURIER_SIMULATION="true"

# ---- Optional (add when the client provides them) ----
# SMTP is REQUIRED for sign-up (6-digit email verification code) — e.g. Gmail: smtp.gmail.com + App Password
# SMTP_HOST="" SMTP_PORT="587" SMTP_SECURE="false" SMTP_USER="" SMTP_PASS=""
# MAIL_FROM="ZARIERA <orders@zariera.com>" ADMIN_NOTIFY_EMAIL=""
# PAYFAST_MERCHANT_ID="" PAYFAST_SECURED_KEY="" PAYFAST_SANDBOX="true"
# SAFEPAY_API_KEY="" SAFEPAY_WEBHOOK_SECRET="" SAFEPAY_SANDBOX="true"
# LEOPARDS_API_KEY="" LEOPARDS_API_PASSWORD="" TCS_USERNAME="" TCS_PASSWORD=""
# TCS_CLIENT_ID="" TCS_CLIENT_SECRET="" TCS_COST_CENTER=""

# ---- AI support chat (Claude) ----
# With a key, the chat bubble answers any customer question from the live catalog,
# store settings and policies (and can look up an order by number + email).
# Without it, the chat runs in basic mode (keyword answers + product search).
# Get a key at https://console.anthropic.com → API Keys. Billed per message.
ANTHROPIC_API_KEY=""
# Optional: model override (default claude-opus-5-5)
CHAT_MODEL=""
