# ---- Database (PostgreSQL) ----
# Local example:
#   DATABASE_URL="postgresql://postgres:password@localhost:5432/zariera?schema=public"
# Hosted (Neon/Supabase) — copy the connection string from your dashboard:
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zariera?schema=public"
# Direct (non-pooled) connection for migrations — same as DATABASE_URL unless
# you use a pooler (Neon "-pooler" host): then put the non-pooled URL here.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/zariera?schema=public"

# ---- App ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Auth (REQUIRED in production) ----
# Signs admin + customer sessions and password-reset links. The app refuses to
# start sessions in production without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"
# Bootstrap admin login (used when no DB user exists yet)
ADMIN_EMAIL="admin@zariera.com"
ADMIN_PASSWORD="change-me"

# ---- Payments (fill in with the client's merchant credentials to go live) ----
# COD works with no config. Online methods activate once these are set.
# PayFast (Pakistan)
PAYFAST_MERCHANT_ID=""
PAYFAST_SECURED_KEY=""
PAYFAST_SANDBOX="true"
# Payment options only appear at checkout once their keys are set.
# Gateway callback URLs (set in each dashboard):
#   PayFast  → {SITE_URL}/api/payments/payfast/callback  (sent automatically as CHECKOUT_URL)
#   Safepay  → {SITE_URL}/api/payments/safepay/webhook
# Safepay (both values required — the webhook secret verifies payments)
SAFEPAY_API_KEY=""
SAFEPAY_WEBHOOK_SECRET=""
SAFEPAY_SANDBOX="true"

# ---- Email (sign-up verification codes, order confirmations, password reset) — any SMTP provider ----
# Required in production: registration emails a 6-digit code. In dev without SMTP the code is printed in the terminal.
# Gmail example: host smtp.gmail.com, port 587, user = your gmail,
# pass = a Google "App Password" (not your normal password).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # true only for port 465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ZARIERA <orders@zariera.com>"
ADMIN_NOTIFY_EMAIL=""        # store owner's email for new-order alerts

# ---- Store contact details (shown in footer / contact page / chat) ----
# Leave blank to hide an item — no placeholder numbers are shown.
NEXT_PUBLIC_WHATSAPP_NUMBER=""     # international format, digits only, e.g. 923001234567
NEXT_PUBLIC_CONTACT_PHONE=""       # display format, e.g. +92 300 1234567
NEXT_PUBLIC_CONTACT_EMAIL=""       # e.g. hello@zariera.com
NEXT_PUBLIC_CONTACT_CITY="Lahore, Pakistan"
NEXT_PUBLIC_CONTACT_HOURS="Mon–Sat, 11am – 8pm"
NEXT_PUBLIC_INSTAGRAM_URL=""       # full URL, e.g. https://instagram.com/zariera
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_TIKTOK_URL=""

# ---- Shipping policy (PKR) — confirm the threshold with the client ----
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="50000"
NEXT_PUBLIC_FLAT_SHIPPING="500"

# ---- Couriers (Leopards / TCS) ----
# Without keys, booking is simulated in development only. In production it is
# refused unless COURIER_SIMULATION="true" (demo servers).
LEOPARDS_API_KEY=""
LEOPARDS_API_PASSWORD=""
LEOPARDS_ORIGIN_CITY="Lahore"
TCS_USERNAME=""
TCS_PASSWORD=""
TCS_CLIENT_ID=""
TCS_CLIENT_SECRET=""
TCS_COST_CENTER=""
TCS_ORIGIN_CITY="Lahore"
COURIER_SIMULATION=""

# ---- Uploads ----
# Admin-uploaded product images are stored here (default: ./uploads).
# Use a persistent volume in Docker (-v zariera-uploads:/app/uploads).
UPLOAD_DIR=""

# ---- AI support chat (Claude) ----
# With a key, the chat bubble answers any customer question from the live catalog,
# store settings and policies (and can look up an order by number + email).
# Without it, the chat runs in basic mode (keyword answers + product search).
# Get a key at https://console.anthropic.com → API Keys. Billed per message.
ANTHROPIC_API_KEY=""
# Optional: model override (default claude-opus-5-5)
CHAT_MODEL=""
