// ZARIERA — Prisma schema (PostgreSQL)
// Scope: Standard package — products, categories, orders, admin

generator client {
  provider      = "prisma-client-js"
  // native = this machine / build box; rhel-openssl-3.0.x = Netlify (AWS Lambda) functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations need a direct (non-pooled) connection. Locally / on a VPS set it
  // to the same value as DATABASE_URL; on Neon use the non "-pooler" URL.
  directUrl = env("DIRECT_URL")
}

// ---------- Catalog ----------

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  description    String?
  // Price in PKR, stored as Decimal for money-safe math
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  sku            String?     @unique
  stock          Int         @default(0)
  images         String[]    @default([])
  material       String?     // e.g. "22K Gold", "Sterling Silver"
  specs          String?     // per-product specs, one "Label: Value" per line
  featured       Boolean     @default(false)
  active         Boolean     @default(true)
  category       Category    @relation(fields: [categoryId], references: [id])
  categoryId     String
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId])
  @@index([featured])
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  PAYFAST
  SAFEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  // Gateway reference (e.g. Safepay tracker) used to match webhooks to orders
  paymentRef    String?

  // Customer (guest checkout supported; linked to an account when signed in)
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String?
  notes         String?

  // Optional link to a registered customer account
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?

  // Money (PKR)
  subtotal      Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  // Courier shipment (Leopards / TCS)
  courier         String?
  trackingNumber  String?
  shippedAt       DateTime?

  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([customerId])
  @@index([paymentRef])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  // Snapshots so historical orders stay accurate if the product changes
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
}

// ---------- Admin ----------

enum Role {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Storefront customer accounts (separate from admin `User`).
model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  // Set once the customer proves they own the email (OTP). Null = unverified
  // (accounts created before OTP existed, or via checkout sign-up).
  emailVerifiedAt DateTime?
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// One-time email codes (OTP). Only a hash of the code is stored.
//  purpose "register": pending sign-up — payload holds name + passwordHash until verified.
//  purpose "verify":   an existing customer confirming their email.
model EmailVerification {
  id          String   @id @default(cuid())
  email       String
  purpose     String
  codeHash    String
  payload     Json?
  attempts    Int      @default(0)
  sendCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([email, purpose])
}

// ---------- Inbound (contact form + newsletter) ----------

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  topic     String?  // e.g. "custom", "notify:<category>"
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // where they signed up (newsletter, notify:<category>)
  createdAt DateTime @default(now())
}

// ---------- Store settings (editable in Admin → Settings) ----------
// Key/value JSON, e.g. key "store" holds contact, socials, shipping, etc.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
