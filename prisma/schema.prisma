// ZARIERA / BOLISTORE — Prisma schema (PostgreSQL)
// Multi-tenant SaaS: every catalog/order/customer/settings row belongs to a Tenant.
// The default tenant is "zariera". The platform super-admin is a User with tenantId = null.

generator client {
  provider      = "prisma-client-js"
  // native = this machine / build box; rhel-openssl-3.0.x = Netlify (AWS Lambda) functions
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations — same as DATABASE_URL unless
  // you use a pooler (Neon "-pooler" host): then put the non-pooled URL here.
  directUrl = env("DIRECT_URL")
}

// ---------- Tenants ----------

model Tenant {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String    // internal / admin label
  displayName String    // shown to customers (store title)
  tagline     String?
  publicUrl   String?   // optional custom domain
  currency    String    @default("PKR") // ISO 4217; zariera = PKR
  logo        String?
  brandColor  String?   // optional accent override
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categories      Category[]
  products        Product[]
  orders          Order[]
  customers       Customer[]
  contactMessages ContactMessage[]
  subscribers     Subscriber[]
  settings        Setting[]
  users           User[]
}

// ---------- Catalog ----------

model Category {
  id          String    @id @default(cuid())
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId    String
  name        String
  slug        String
  description String?
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Product {
  id             String      @id @default(cuid())
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId       String
  name           String
  slug           String
  description    String?
  // Price in the tenant's currency, stored as Decimal for money-safe math
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  sku            String?
  stock          Int         @default(0)
  images         String[]    @default([])
  material       String?     // e.g. "22K Gold", "Sterling Silver"
  specs          String?     // per-product specs, one "Label: Value" per line
  featured       Boolean     @default(false)
  active         Boolean     @default(true)
  category       Category    @relation(fields: [categoryId], references: [id])
  categoryId     String
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([tenantId, slug])
  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([featured])
}

// ---------- Orders ----------

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  PAYFAST
  SAFEPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String        @id @default(cuid())
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId      String
  orderNumber   String
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  // Gateway reference (e.g. Safepay tracker) used to match webhooks to orders
  paymentRef    String?

  // Customer (guest checkout supported; linked to an account when signed in)
  customerName  String
  email         String
  phone         String
  address       String
  city          String
  postalCode    String?
  notes         String?

  // Optional link to a registered customer account
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerId    String?

  // Money (tenant currency)
  subtotal      Decimal       @db.Decimal(10, 2)
  shipping      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)

  // Courier shipment (Leopards / TCS)
  courier         String?
  trackingNumber  String?
  shippedAt       DateTime?

  items         OrderItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, email])
  @@index([tenantId, customerId])
  @@index([tenantId, paymentRef])
  @@index([tenantId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  // Snapshots so historical orders stay accurate if the product changes
  name      String
  price     Decimal  @db.Decimal(10, 2)
  quantity  Int

  @@index([orderId])
}

// ---------- Admin ----------

enum Role {
  ADMIN
  STAFF
}

// Users are scoped to a tenant. tenantId = null marks the platform super-admin
// (manages tenants) — not built until Phase 2.
model User {
  id           String    @id @default(cuid())
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String?
  email        String
  passwordHash String
  name         String?
  role         Role      @default(ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

// Storefront customer accounts (separate from admin `User`).
model Customer {
  id           String    @id @default(cuid())
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  name         String
  email        String
  passwordHash String
  phone        String?
  // Set once the customer proves they own the email (OTP). Null = unverified
  // (accounts created before OTP existed, or via checkout sign-up).
  emailVerifiedAt DateTime?
  orders       Order[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

// One-time email codes (OTP). Only a hash of the code is stored.
//  purpose "register": pending sign-up — payload holds name + passwordHash until verified.
//  purpose "verify":   an existing customer confirming their email.
model EmailVerification {
  id          String   @id @default(cuid())
  email       String
  purpose     String
  codeHash    String
  payload     Json?
  attempts    Int      @default(0)
  sendCount   Int      @default(1)
  lastSentAt  DateTime @default(now())
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@unique([email, purpose])
}

// ---------- Inbound (contact form + newsletter) ----------

model ContactMessage {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  topic     String?  // e.g. "custom", "notify:<category>"
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  email     String
  source    String?  // where they signed up (newsletter, notify:<category>)
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
}

// ---------- Store settings (editable in Admin → Settings) ----------
// Key/value JSON, per tenant. Key "store" holds contact, socials, shipping, etc.
model Setting {
  id        String    @id @default(cuid())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String
  key       String
  value     Json
  updatedAt DateTime  @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId])
}
